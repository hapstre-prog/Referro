# GEMINI_API_KEY: Required for Gemini AI API calls (network structuring, matching, intro drafting).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for production persistence
DATABASE_URL="postgresql://user:password@localhost:5432/relay_referrals"

# AUTH_SECRET: Session encryption key for JWT and secure cookies
AUTH_SECRET="your-32-byte-random-auth-secret-string"

# LINKEDIN_CLIENT_ID & LINKEDIN_CLIENT_SECRET: Official LinkedIn OAuth / OpenID Connect credentials
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"

# STRIPE_SECRET_KEY & STRIPE_PUBLISHABLE_KEY: Payment provider keys for credit purchases & payouts
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# EMAIL_API_KEY: Transactional email notifications (Resend / SendGrid)
EMAIL_API_KEY="re_..."

